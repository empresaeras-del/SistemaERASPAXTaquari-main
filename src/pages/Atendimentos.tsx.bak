import React, { useState } from 'react';
import { useAppContext } from '../context/AppContext';
import { useToast } from '../context/ToastContext';
import { useConfirm } from '../context/ConfirmContext';
import { Plus, Search, Filter, CheckCircle, Clock, XCircle, Edit2, X } from 'lucide-react';

interface Atendimento {
  id: string;
  titular: string;
  falecido: string;
  data: string;
  status: 'aberto' | 'processamento' | 'finalizado' | 'cancelado';
  responsavel: string;
}

export const AtendimentosPage: React.FC = () => {
  const { state } = useAppContext();
  const toast = useToast();
  const { confirm } = useConfirm();
  const [searchTerm, setSearchTerm] = useState('');
  const [statusFilter, setStatusFilter] = useState('');
  const [showFilters, setShowFilters] = useState(false);
  const [previewAtendimento, setPreviewAtendimento] = useState<Atendimento | null>(null);

  
  const [atendimentos, setAtendimentos] = useState<Atendimento[]>([
    { id: '1001', titular: 'João da Silva', falecido: 'Maria da Silva', data: '2023-10-24', status: 'aberto', responsavel: 'Admin ERAS' },
    { id: '1002', titular: 'Carlos Souza', falecido: 'Carlos Souza', data: '2023-10-23', status: 'processamento', responsavel: 'Admin ERAS' },
    { id: '1003', titular: 'Ana Costa', falecido: 'José Costa', data: '2023-10-20', status: 'finalizado', responsavel: 'Admin ERAS' },
  ]);

  const filtered = atendimentos.filter(a => {
    const matchesSearch = a.titular.toLowerCase().includes(searchTerm.toLowerCase()) || a.falecido.toLowerCase().includes(searchTerm.toLowerCase());
    const matchesStatus = statusFilter ? a.status === statusFilter : true;
    return matchesSearch && matchesStatus;
  });
  const [isModalOpen, setIsModalOpen] = useState(false);
  const [editingAtendimento, setEditingAtendimento] = useState<Partial<Atendimento> | null>(null);

  const handleOpenModal = (atd?: Atendimento) => {
    if (atd) {
      setEditingAtendimento({ ...atd });
    } else {
      setEditingAtendimento({
        id: Math.floor(1000 + Math.random() * 9000).toString(),
        status: 'aberto',
        data: new Date().toISOString().split('T')[0],
        responsavel: state.user?.nome || 'Admin'
      });
    }
    setIsModalOpen(true);
  };
  const handleCloseModal = () => {
    setIsModalOpen(false);
    setEditingAtendimento(null);
  };

  const handleSave = (e: React.FormEvent) => {
    e.preventDefault();
    if (!editingAtendimento || !editingAtendimento.id) return;
    
    const novoAtd = editingAtendimento as Atendimento;
    
    setAtendimentos(current => {
      const exists = current.find(a => a.id === novoAtd.id);
      if (exists) {
        return current.map(a => a.id === novoAtd.id ? novoAtd : a);
      }
      return [novoAtd, ...current];
    });
    
    handleCloseModal();
    toast.success("Atendimento salvo com sucesso!");
  };

  const handleCancel = (id: string) => {
    confirm({
      title: "Cancelar Atendimento",
      message: "Tem certeza que deseja cancelar este atendimento? Esta ação não pode ser desfeita.",
      danger: true,
      confirmText: "Cancelar",
      onConfirm: async () => {
        try {
          setAtendimentos(current => current.map(a => a.id === id ? { ...a, status: 'cancelado' } : a));
          toast.success("Atendimento cancelado com sucesso!");
        } catch (error) {
          console.error("Erro ao cancelar", error);
          toast.error("Erro ao cancelar atendimento.");
        }
      }
    });
  };


  return (
    <div className="space-y-6 max-w-7xl mx-auto pb-12 h-full flex flex-col">
      <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h2 className="text-2xl font-bold tracking-tight text-white">Atendimentos Funerários</h2>
          <p className="text-slate-400 mt-1">Coordenação e acompanhamento de óbitos e serviços.</p>
        </div>
        
        <button 
          onClick={() => handleOpenModal()}
          className="inline-flex items-center justify-center gap-2 px-4 py-2 bg-[#7E4CF3] hover:bg-[#6A3DE8] text-white rounded-xl font-medium transition-colors"
        >
          <Plus className="w-5 h-5" />
          Novo Atendimento
        </button>
      </div>

      <div className="flex gap-6 flex-1 min-h-0">
      <div className={`bg-[#181B34] border border-[#262A45] rounded-2xl overflow-hidden shadow-sm flex-1 flex flex-col ${previewAtendimento ? 'hidden lg:flex' : 'flex'}`}>
        <div className="p-4 border-b border-[#262A45] flex flex-col sm:flex-row sm:items-center gap-4 justify-between bg-[#101223]/50">
          <div className="relative max-w-md w-full">
            <Search className="w-5 h-5 absolute left-3 top-1/2 -translate-y-1/2 text-slate-400" />
            <input 
              type="text" 
              placeholder="Buscar por titular ou falecido..." 
              value={searchTerm}
              onChange={(e) => setSearchTerm(e.target.value)}
              className="w-full bg-[#101223] border border-[#262A45] rounded-xl pl-10 pr-4 py-2 text-white focus:outline-none focus:border-[#7E4CF3]"
            />
          </div>
          
          <button className="inline-flex items-center gap-2 px-4 py-2 border border-[#262A45] rounded-lg text-slate-300 font-medium hover:bg-white/5 transition-colors">
            <Filter className="w-4 h-4" />
            Filtros
          </button>
        </div>

        <div className="overflow-x-auto flex-1">
          <table className="w-full text-left text-sm text-slate-300">
            <thead className="bg-[#101223]/30 border-b border-[#262A45]">
              <tr>
                <th className="px-6 py-3 text-xs font-semibold text-slate-400 uppercase tracking-wider">Protocolo</th>
                <th className="px-6 py-3 text-xs font-semibold text-slate-400 uppercase tracking-wider">Titular Responsável</th>
                <th className="px-6 py-3 text-xs font-semibold text-slate-400 uppercase tracking-wider">Nome do Falecido</th>
                <th className="px-6 py-3 text-xs font-semibold text-slate-400 uppercase tracking-wider">Data/Hora</th>
                <th className="px-6 py-3 text-xs font-semibold text-slate-400 uppercase tracking-wider">Status</th>
                <th className="px-6 py-3 text-right text-xs font-semibold text-slate-400 uppercase tracking-wider">Ações</th>
              </tr>
            </thead>
            <tbody className="divide-y divide-[#262A45]">
              {filtered.map((atd) => (
                <tr key={atd.id} className="hover:bg-[#101223]/30 transition-colors cursor-pointer"
                    onClick={() => setPreviewAtendimento(atd)}>
                  <td className="px-6 py-4 font-medium text-white">#{atd.id}</td>
                  <td className="px-6 py-4">{atd.titular}</td>
                  <td className="px-6 py-4">{atd.falecido}</td>
                  <td className="px-6 py-4">{new Date(atd.data).toLocaleDateString('pt-BR')}</td>
                  <td className="px-6 py-4">
                    <span className={`inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium border ${
                      atd.status === 'aberto' ? 'bg-rose-500/10 text-rose-400 border-rose-500/20' :
                      atd.status === 'processamento' ? 'bg-amber-500/10 text-amber-400 border-amber-500/20' :
                      atd.status === 'cancelado' ? 'bg-slate-500/10 text-slate-400 border-slate-500/20' :
                      'bg-emerald-500/10 text-emerald-400 border-emerald-500/20'
                    }`}>
                      {atd.status === 'aberto' && <Clock className="w-3.5 h-3.5" />}
                      {atd.status === 'processamento' && <Clock className="w-3.5 h-3.5" />}
                      {atd.status === 'finalizado' && <CheckCircle className="w-3.5 h-3.5" />}
                      {atd.status === 'cancelado' && <XCircle className="w-3.5 h-3.5" />}
                      <span className="capitalize">{atd.status}</span>
                    </span>
                  </td>
                  <td className="px-6 py-4 text-right">
                    <div className="flex justify-end gap-2">
                      <button 
                        onClick={() => handleOpenModal(atd)}
                        className="p-1 text-slate-400 hover:text-white hover:bg-white/5 rounded-lg transition-colors" 
                        title="Editar"
                      >
                        <Edit2 className="w-4 h-4" />
                      </button>
                      {atd.status !== 'cancelado' && (
                        <button 
                          onClick={() => handleCancel(atd.id)}
                          className="p-1 text-slate-400 hover:text-rose-400 hover:bg-rose-500/10 rounded-lg transition-colors"
                          title="Cancelar"
                        >
                          <XCircle className="w-4 h-4" />
                        </button>
                      )}
                    </div>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      </div>
      {isModalOpen && editingAtendimento && (
        <div className="fixed inset-0 z-50 flex items-center justify-center bg-[#0A0C16]/80 backdrop-blur-sm p-4">
          <div className="bg-[#181B34] rounded-3xl shadow-2xl w-full max-w-2xl max-h-[90vh] flex flex-col border border-[#262A45] overflow-hidden">
            <div className="px-6 py-4 border-b border-[#262A45] flex items-center justify-between shrink-0">
              <h3 className="text-xl font-bold text-white tracking-tight">
                {editingAtendimento.titular ? 'Editar Atendimento' : 'Novo Atendimento'}
              </h3>
              <button onClick={handleCloseModal} className="text-slate-400 hover:text-white transition-colors">
                <X className="w-5 h-5" />
              </button>
            </div>
            
            <form onSubmit={handleSave} className="flex-1 overflow-y-auto p-6 space-y-6">
              <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div className="space-y-1">
                  <label className="block text-sm font-semibold text-slate-400 mb-1">Titular Responsável</label>
                  <input
                    required
                    type="text"
                    value={editingAtendimento.titular || ''}
                    onChange={(e) => setEditingAtendimento({ ...editingAtendimento, titular: e.target.value })}
                    className="w-full px-4 py-2.5 bg-[#101223] border border-[#262A45] rounded-xl text-white focus:outline-none focus:ring-2 focus:ring-[#7E4CF3]/50 focus:border-[#7E4CF3] transition-all"
                    placeholder="Ex: João da Silva"
                  />
                </div>
                
                <div className="space-y-1">
                  <label className="block text-sm font-semibold text-slate-400 mb-1">Nome do Falecido</label>
                  <input
                    required
                    type="text"
                    value={editingAtendimento.falecido || ''}
                    onChange={(e) => setEditingAtendimento({ ...editingAtendimento, falecido: e.target.value })}
                    className="w-full px-4 py-2.5 bg-[#101223] border border-[#262A45] rounded-xl text-white focus:outline-none focus:ring-2 focus:ring-[#7E4CF3]/50 focus:border-[#7E4CF3] transition-all"
                    placeholder="Ex: Maria da Silva"
                  />
                </div>
                
                <div className="space-y-1">
                  <label className="block text-sm font-semibold text-slate-400 mb-1">Data/Hora</label>
                  <input
                    required
                    type="date"
                    value={editingAtendimento.data || ''}
                    onChange={(e) => setEditingAtendimento({ ...editingAtendimento, data: e.target.value })}
                    className="w-full px-4 py-2.5 bg-[#101223] border border-[#262A45] rounded-xl text-white focus:outline-none focus:ring-2 focus:ring-[#7E4CF3]/50 focus:border-[#7E4CF3] transition-all"
                  />
                </div>

                <div className="space-y-1">
                  <label className="block text-sm font-semibold text-slate-400 mb-1">Responsável (Atendente)</label>
                  <input
                    required
                    type="text"
                    value={editingAtendimento.responsavel || ''}
                    onChange={(e) => setEditingAtendimento({ ...editingAtendimento, responsavel: e.target.value })}
                    className="w-full px-4 py-2.5 bg-[#101223] border border-[#262A45] rounded-xl text-slate-400 focus:outline-none focus:ring-2 focus:ring-[#7E4CF3]/50 focus:border-[#7E4CF3] transition-all"
                  />
                </div>
                
                <div className="space-y-1 md:col-span-2">
                  <label className="block text-sm font-semibold text-slate-400 mb-1">Status</label>
                  <select
                    required
                    value={editingAtendimento.status || 'aberto'}
                    onChange={(e) => setEditingAtendimento({ ...editingAtendimento, status: e.target.value as Atendimento['status'] })}
                    className="w-full px-4 py-2.5 bg-[#101223] border border-[#262A45] rounded-xl text-white focus:outline-none focus:ring-2 focus:ring-[#7E4CF3]/50 focus:border-[#7E4CF3] transition-all"
                  >
                    <option value="aberto">Aberto</option>
                    <option value="processamento">Em Processamento</option>
                    <option value="finalizado">Finalizado</option>
                    <option value="cancelado">Cancelado</option>
                  </select>
                </div>
              </div>

              <div className="pt-4 mt-6 border-t border-[#262A45] flex justify-end gap-3 shrink-0">
                <button
                  type="button"
                  onClick={handleCloseModal}
                  className="px-4 py-2 bg-[#222542] border border-[#2A2D48] text-slate-300 rounded-xl font-medium hover:bg-[#2A2D48] hover:text-white transition-colors"
                >
                  Cancelar
                </button>
                <button
                  type="submit"
                  className="px-4 py-2 bg-gradient-to-r from-[#7E4CF3] to-[#4A88E9] text-white rounded-xl font-medium hover:opacity-90 transition-opacity shadow-lg shadow-[#7E4CF3]/25"
                >
                  Salvar
                </button>
              </div>
            </form>
          </div>
        </div>
      )}
    </div>
  );
};
