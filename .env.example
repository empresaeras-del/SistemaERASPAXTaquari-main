# =============================================================================
# SISTEMA ERAS PAX TAQUARI — EXEMPLO DE VARIÁVEIS DE AMBIENTE (.env)
# =============================================================================
# NOTA DE SEGURANÇA:
# 1. NUNCA comite o arquivo .env com chaves de produção no repositório Git.
# 2. Em plataformas como Vercel, Netlify, Render, Cloudflare Pages ou Docker,
#    adicione estas variáveis diretamente no painel "Environment Variables" / Secrets do servidor.
# =============================================================================

# --- SUPABASE CONFIGURATION (Obrigatório) ---
VITE_SUPABASE_URL="https://seu-projeto.supabase.co"
VITE_SUPABASE_ANON_KEY="sua_chave_anonima_publica_aqui"

# --- GEMINI AI API (Opcional / Recursos inteligentes) ---
VITE_GEMINI_API_KEY=""

# --- SENTRY MONITORING (Opcional / Rastreamento de erros em produção) ---
VITE_SENTRY_DSN=""

# --- APPLICATION URL ---
APP_URL="https://seu-dominio.com.br"

